# ====================================================================
# ARPIT SOLAR SHOP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with your production credentials
# ====================================================================

# Database Connection (Supabase PostgreSQL direct or pooler URI)
PG_URI=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Public & Server Endpoints
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase API Keys
# Public anon key (for client-side queries)
NEXT_PUBLIC_SUPABASE_KEY=[YOUR-ANON-PUBLIC-KEY]

# Secret service role key (for server-side storage and admin operations)
SUPABASE_KEY=[YOUR-SERVICE-ROLE-SECRET-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-SECRET-KEY]

# Storage Buckets:
# 'quotes' for PDF quotations
# 'company-assets' for logo, seal/signature, and UPI QR code
SUPABASE_BUCKET=quotes

# Better Auth Configuration (Self-Hosted Authentication & Sessions)
BETTER_AUTH_SECRET=your-secure-random-32-byte-hex-string
BETTER_AUTH_URL=https://your-production-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-production-app.vercel.app

# WhatsApp Integration (DoubleTick API)
# Optional: Direct 1-click WhatsApp web/app redirect works natively without an API key.
DOUBLETICK_API_KEY=
DOUBLETICK_SENDER_PHONE=+919005770466

# Email Integration (SMTP) - Optional
# If omitted, system generates client-side mailto links with quotation body prefilled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=arpitsolarshop@gmail.com
SMTP_PASS=
