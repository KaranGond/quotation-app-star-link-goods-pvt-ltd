# ====================================================================
# STAR LINK GOODS PVT. LTD. - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with your production credentials
# ====================================================================

# 1. Database Connection (Supabase IPv4 Pooler - Works everywhere including Vercel & Localhost)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres
PG_URI=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# 2. Authentication Configuration (Better Auth)
BETTER_AUTH_SECRET=your-secure-random-32-byte-hex-string
BETTER_AUTH_URL=https://your-production-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-production-app.vercel.app

# 3. Supabase Storage (for Quote PDFs & Company Assets)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-SECRET-KEY]
SUPABASE_BUCKET=quotes

# 4. Optional Integrations
# WhatsApp DoubleTick API (Optional - 1-click WhatsApp redirect works natively without API key)
DOUBLETICK_API_KEY=
DOUBLETICK_SENDER_PHONE=+919005770466

# SMTP Email (Optional - Mailto links work natively without SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@starlinkgoods.com
SMTP_PASS=
